<%@ page contentType="text/html;charset=UTF-8" language="java" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Create deadline | StudentHub</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><link href="${pageContext.request.contextPath}/assets/css/main.css" rel="stylesheet"></head><body class="auth-page"><main class="container py-5"><div class="auth-card card border-0 shadow-lg mx-auto"><div class="card-body p-4 p-md-5"><a href="${pageContext.request.contextPath}/deadlines">Back to deadlines</a><h1 class="h2 mt-3">Create deadline</h1><p class="text-secondary">Semester and section values come from your authenticated account.</p><c:if test="${not empty error}"><div class="alert alert-danger"><c:out value="${error}" /></div></c:if><form method="post" action="${pageContext.request.contextPath}/deadlines/create"><input type="hidden" name="csrfToken" value="<c:out value='${csrfToken}' />"><div class="mb-3"><label class="form-label" for="title">Title</label><input class="form-control" id="title" name="title" maxlength="200" required></div><div class="mb-3"><label class="form-label" for="subjectName">Subject</label><input class="form-control" id="subjectName" name="subjectName" maxlength="100" required></div><div class="mb-3"><label class="form-label" for="dueDate">Due date and time</label><input class="form-control" type="datetime-local" id="dueDate" name="dueDate" required></div><div class="mb-3"><label class="form-label" for="scope">Scope</label><select class="form-select" id="scope" name="scope" required><option value="SEMESTER">My semester</option><option value="SECTION">My section</option></select></div><div class="mb-4"><label class="form-label" for="postId">Related announcement ID <span class="text-secondary">(optional)</span></label><input class="form-control" type="number" min="1" id="postId" name="postId"><div class="form-text">You may only link an announcement you are authorized to manage.</div></div><button class="btn btn-primary" type="submit">Create deadline</button></form></div></div></main></body></html>
