<%@ page contentType="text/html;charset=UTF-8" language="java" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Comments | StudentHub</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><script src="${pageContext.request.contextPath}/assets/js/main.js?v=${applicationScope.assetVersion}" defer></script><link href="${pageContext.request.contextPath}/assets/css/main.css?v=${applicationScope.assetVersion}" rel="stylesheet"><link href="${pageContext.request.contextPath}/assets/css/dashboard.css?v=${applicationScope.assetVersion}" rel="stylesheet"></head><body class="dashboard-body">
<header class="mobile-header d-lg-none"><a class="dashboard-brand" href="${pageContext.request.contextPath}/home"><span>S</span> StudentHub</a><button class="btn btn-light" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileNavigation">Menu</button></header><div class="offcanvas offcanvas-start" tabindex="-1" id="mobileNavigation"><div class="offcanvas-header"><h2 class="offcanvas-title h5">StudentHub</h2><button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button></div><div class="offcanvas-body"><jsp:include page="../partials/sidebar.jsp"/></div></div>
<div class="dashboard-shell comments-shell"><aside class="dashboard-sidebar d-none d-lg-flex"><jsp:include page="../partials/sidebar.jsp"/></aside><main class="comments-column"><a class="comments-back" href="${pageContext.request.contextPath}/announcements">← Back to announcements</a><c:if test="${not empty message}"><div class="alert alert-success"><c:out value="${message}"/></div></c:if><c:if test="${not empty error}"><div class="alert alert-warning"><c:out value="${error}"/></div></c:if>
<c:if test="${not empty post}"><article class="post-card comments-original"><header class="post-header"><a class="profile-identity-link" href="${pageContext.request.contextPath}/profile?userId=${post.authorId}"><div class="avatar"><c:choose><c:when test="${not empty post.authorAvatarUrl}"><c:url var="postAvatar" value="/profile/photo/${post.authorAvatarUrl}"/><img src="${postAvatar}" alt=""></c:when><c:otherwise><c:out value="${post.authorName.substring(0,1)}"/></c:otherwise></c:choose></div></a><div class="post-author"><div><a class="profile-name-link" href="${pageContext.request.contextPath}/profile?userId=${post.authorId}"><strong><c:out value="${post.authorName}"/></strong></a><span class="role-badge role-${post.authorRole}"><c:out value="${post.authorRole}"/></span></div><time><c:out value="${post.createdLabel}"/></time></div></header><div class="post-content"><h1><c:out value="${post.title}"/></h1><p><c:out value="${post.content}"/></p></div></article>
<c:set var="attachment" value="${post.attachment}" scope="request"/><jsp:include page="../partials/attachment.jsp"/><section class="comments-panel"><div class="feed-heading"><div><p class="eyebrow mb-1">Conversation</p><h2 class="h3 mb-0">Comments</h2></div></div><form class="comment-composer" method="post" enctype="multipart/form-data" action="${pageContext.request.contextPath}/posts/comments/add"><input type="hidden" name="csrfToken" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="postId" value="${post.postId}"><label class="attachment-button" title="Attach a file">📎<input type="file" name="attachment" accept="image/jpeg,image/png,image/webp,image/gif,video/mp4,video/webm,.pdf,.doc,.docx,.ppt,.pptx,.xls,.xlsx,.txt,.zip"></label><label class="visually-hidden" for="commentContent">Add a comment</label><textarea id="commentContent" name="content" rows="3" maxlength="5000" placeholder="Write a comment..."></textarea><button class="btn btn-primary" type="submit">Post comment</button></form>
<div class="comment-list"><c:choose><c:when test="${empty comments}"><div class="comments-empty"><p>No comments yet. Start the conversation.</p></div></c:when><c:otherwise><c:forEach var="comment" items="${comments}"><article class="comment-card ${sessionScope.userId eq comment.authorId ? 'own-comment' : ''}"><a class="profile-identity-link" href="${pageContext.request.contextPath}/profile?userId=${comment.authorId}"><div class="avatar comment-avatar"><c:choose><c:when test="${not empty comment.authorAvatarUrl}"><c:url var="commentAvatar" value="/profile/photo/${comment.authorAvatarUrl}"/><img src="${commentAvatar}" alt=""></c:when><c:otherwise><c:out value="${comment.authorName.substring(0,1)}"/></c:otherwise></c:choose></div></a><div class="comment-content"><header><a class="profile-name-link" href="${pageContext.request.contextPath}/profile?userId=${comment.authorId}"><strong><c:out value="${comment.authorName}"/></strong></a><span class="role-badge role-${comment.authorRole}"><c:out value="${comment.authorRole}"/></span><time><c:out value="${comment.createdLabel}"/></time></header><p><c:out value="${comment.content}"/></p><c:set var="attachment" value="${comment.attachment}" scope="request"/><jsp:include page="../partials/attachment.jsp"/><c:if test="${sessionScope.role eq 'ADMIN' or sessionScope.userId eq comment.authorId}"><form method="post" action="${pageContext.request.contextPath}/posts/comments/delete" onsubmit="return confirm('Delete this comment?');"><input type="hidden" name="csrfToken" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="commentId" value="${comment.commentId}"><button type="submit">Delete</button></form></c:if></div></article></c:forEach></c:otherwise></c:choose></div></section></c:if></main></div><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script></body></html>
