<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:if test="${not empty attachment}"><c:url var="attachmentUrl" value="/attachments/${attachment.attachmentId}"/><div class="content-attachment chat-media-card"><c:choose>
<c:when test="${attachment.image}"><a class="chat-image-link" href="${attachmentUrl}" target="_blank" rel="noopener"><img class="chat-image" src="${attachmentUrl}" alt="<c:out value='${attachment.originalFilename}'/>" loading="lazy"></a><a class="media-download chat-media-download" href="${attachmentUrl}?download=1" title="Download image" aria-label="Download image"><svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg><span>Download</span></a></c:when>
<c:when test="${attachment.video}"><video class="chat-video" controls preload="metadata"><source src="${attachmentUrl}" type="<c:out value='${attachment.mimeType}'/>">Your browser cannot play this video.</video><a class="media-download chat-media-download" href="${attachmentUrl}?download=1" title="Download video" aria-label="Download video"><svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg><span>Download</span></a></c:when>
<c:when test="${attachment.audio}"><div class="audio-attachment chat-audio-attachment"><div class="chat-doc-info"><span class="chat-doc-icon audio-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg></span><span class="chat-doc-meta"><strong><c:out value="${attachment.originalFilename}"/></strong><small><c:out value="${attachment.sizeLabel}"/></small></span></div><audio controls preload="metadata"><source src="${attachmentUrl}" type="<c:out value='${attachment.mimeType}'/>">Your browser cannot play this audio.</audio><a class="media-download chat-media-download" href="${attachmentUrl}?download=1" title="Download audio" aria-label="Download audio"><svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg><span>Download</span></a></div></c:when>
<c:otherwise><a class="file-attachment chat-doc-link" href="${attachmentUrl}?download=1" title="Download <c:out value='${attachment.originalFilename}'/>"><span class="chat-doc-icon file-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg></span><span class="chat-doc-meta"><strong><c:out value="${attachment.originalFilename}"/></strong><small><c:out value="${attachment.sizeLabel}"/></small></span><span class="chat-doc-action" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg></span></a></c:otherwise>
</c:choose></div></c:if>
