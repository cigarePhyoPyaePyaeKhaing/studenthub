<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<section class="post-feed" aria-label="StudentHub announcements"><c:choose><c:when test="${empty posts}"><div class="empty-state"><div class="empty-icon">SH</div><h3>No announcements yet.</h3><p>New announcements will appear here.</p></div></c:when><c:otherwise>
<c:forEach var="post" items="${posts}"><article class="post-card"><header class="post-header">
<a class="profile-identity-link" href="${pageContext.request.contextPath}/profile?userId=${post.authorId}" aria-label="View profile"><div class="avatar"><c:choose><c:when test="${not empty post.authorAvatarUrl}"><c:url var="postAvatarUrl" value="/profile/photo/${post.authorAvatarUrl}"/><img src="${postAvatarUrl}" alt=""></c:when><c:otherwise><c:out value="${post.authorName.substring(0,1)}"/></c:otherwise></c:choose></div></a>
<div class="post-author"><div><a class="profile-name-link" href="${pageContext.request.contextPath}/profile?userId=${post.authorId}"><strong><c:out value="${post.authorName}"/></strong></a><span class="role-badge role-${post.authorRole}"><c:out value="${post.authorRole}"/></span></div><time><c:out value="${post.createdLabel}"/></time></div><c:if test="${not empty post.categoryName}"><span class="post-category"><c:out value="${post.categoryName}"/></span></c:if></header>
<div class="visibility-label"><c:out value="${post.visibility}"/></div><div class="post-content"><h3><c:out value="${post.title}"/></h3><p><c:out value="${post.content}"/></p></div>
<c:if test="${post.hasDeadline()}"><div class="post-deadline-box ${post.expired ? 'expired' : (post.status eq 'Due soon' ? 'due-soon' : 'upcoming')}"><div class="post-deadline-icon">⏱</div><div class="post-deadline-text"><span class="post-deadline-label">Deadline</span><strong class="post-deadline-date"><c:out value="${post.dueLabel}"/></strong></div><span class="post-deadline-badge"><c:out value="${post.timeRemainingLabel}"/></span></div></c:if>
<footer class="post-footer"><div class="engagement-controls"><form method="post" action="${pageContext.request.contextPath}/posts/react"><input type="hidden" name="csrfToken" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="postId" value="${post.postId}"><input type="hidden" name="source" value="${pageContext.request.servletPath eq '/home' ? 'home' : 'announcements'}"><input type="hidden" name="category" value="<c:out value='${selectedCategory}'/>"><button class="reaction-button ${post.reactedByCurrentUser ? 'active' : ''}" type="submit" aria-pressed="${post.reactedByCurrentUser}">${post.reactedByCurrentUser ? '♥' : '♡'} <strong><c:out value="${post.reactionCount}"/></strong></button></form><a class="comments-link" href="${pageContext.request.contextPath}/posts/comments?postId=${post.postId}">Comments <strong><c:out value="${post.commentCount}"/></strong></a></div>
<c:if test="${sessionScope.role eq 'ADMIN' or (sessionScope.role eq 'CR' and sessionScope.userId eq post.authorId)}"><div class="post-management"><a href="${pageContext.request.contextPath}/posts/edit?id=${post.postId}">Edit</a><form method="post" action="${pageContext.request.contextPath}/posts/delete" onsubmit="return confirm('Are you sure you want to delete this announcement?');"><input type="hidden" name="csrfToken" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="id" value="${post.postId}"><button type="submit">Delete</button></form></div></c:if></footer></article></c:forEach>
</c:otherwise></c:choose></section>
