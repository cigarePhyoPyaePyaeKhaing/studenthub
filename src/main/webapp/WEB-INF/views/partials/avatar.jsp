<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><span class="avatar-safe"><span class="avatar-fallback" aria-hidden="true"><c:out value="${param.initial}"/></span><c:if test="${not empty param.photo}"><c:url var="safePhotoUrl" value="/profile/photo/${param.photo}"><c:param name="v" value="${param.photo}"/></c:url><img src="${safePhotoUrl}" alt="" loading="lazy" onerror="this.hidden=true;this.previousElementSibling.hidden=false" onload="this.previousElementSibling.hidden=true"></c:if></span>
