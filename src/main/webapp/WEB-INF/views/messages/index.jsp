<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Private Messages | StudentHub</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><script src="${pageContext.request.contextPath}/assets/js/main.js?v=${applicationScope.assetVersion}" defer></script><link href="${pageContext.request.contextPath}/assets/css/main.css?v=${applicationScope.assetVersion}" rel="stylesheet"><link href="${pageContext.request.contextPath}/assets/css/dashboard.css?v=${applicationScope.assetVersion}" rel="stylesheet"></head><body class="dashboard-body">
<header class="mobile-header d-lg-none"><a class="dashboard-brand" href="${pageContext.request.contextPath}/home">StudentHub</a></header>
<div class="dashboard-shell private-chat-shell"><aside class="dashboard-sidebar d-none d-lg-flex"><jsp:include page="../partials/sidebar.jsp"/></aside><main class="private-chat-layout">
 <aside class="conversation-list ${not empty selectedConversation ? 'has-selection' : ''}"><header><h1>Messages</h1><a href="${pageContext.request.contextPath}/discussions">Academic rooms</a></header><c:choose><c:when test="${empty conversations}"><p class="private-empty">Open a student's profile and choose Message to begin.</p></c:when><c:otherwise><c:forEach var="conversation" items="${conversations}"><a class="conversation-item ${selectedConversation.conversationId eq conversation.conversationId ? 'active' : ''}" href="${pageContext.request.contextPath}/messages?conversationId=${conversation.conversationId}"><span class="conversation-avatar"><jsp:include page="../partials/avatar.jsp"><jsp:param name="photo" value="${conversation.otherAvatar}"/><jsp:param name="initial" value="${conversation.otherName.substring(0,1)}"/></jsp:include></span><span class="conversation-copy"><strong><c:out value="${conversation.otherName}"/></strong><small><c:out value="${conversation.preview}"/></small></span><span class="conversation-meta"><time><c:out value="${conversation.updatedLabel}"/></time><c:if test="${conversation.unread gt 0}"><b><c:out value="${conversation.unread}"/></b></c:if></span></a></c:forEach></c:otherwise></c:choose></aside>
 <section class="private-thread"><c:choose><c:when test="${empty selectedConversation}"><div class="private-empty thread-empty"><h2>Your private messages</h2><p>Select a conversation to start chatting.</p></div></c:when><c:otherwise><header class="private-thread-header"><a class="thread-back" href="${pageContext.request.contextPath}/messages" aria-label="Back">&#8592;</a><a href="${pageContext.request.contextPath}/profile?userId=${selectedConversation.otherUserId}" class="thread-identity"><span class="thread-avatar"><jsp:include page="../partials/avatar.jsp"><jsp:param name="photo" value="${selectedConversation.otherAvatar}"/><jsp:param name="initial" value="${selectedConversation.otherName.substring(0,1)}"/></jsp:include></span><span><strong><c:out value="${selectedConversation.otherName}"/></strong><small class="${selectedConversation.activeNow ? 'active-now' : ''}"><c:out value="${selectedConversation.presenceLabel}"/></small></span></a></header>
 <div class="private-message-list" data-conversation="${selectedConversation.conversationId}" data-current-user="${sessionScope.userId}"><c:forEach var="chatMessage" items="${privateMessages}"><article class="private-bubble ${chatMessage.senderId eq sessionScope.userId ? 'outgoing' : 'incoming'}" data-message-id="${chatMessage.messageId}"><c:if test="${not empty chatMessage.message}"><p><c:out value="${chatMessage.message}"/></p></c:if><c:if test="${not empty chatMessage.attachment}"><c:url var="fileUrl" value="/messages/attachments/${chatMessage.attachment.attachmentId}"/><a class="private-file" href="${fileUrl}" target="_blank"><c:out value="${chatMessage.attachment.originalFilename}"/></a></c:if><time><c:out value="${chatMessage.createdLabel}"/></time></article></c:forEach></div>
 <form class="private-composer" enctype="multipart/form-data" action="${pageContext.request.contextPath}/messages/send"><input type="hidden" name="csrfToken" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="conversationId" value="${selectedConversation.conversationId}"><input type="hidden" name="clientMessageId"><label class="attachment-button" title="Attach a file">&#128206;<input name="attachment" type="file" accept="image/jpeg,image/png,image/webp,image/gif,video/mp4,video/webm,.pdf,.doc,.docx,.ppt,.pptx,.xls,.xlsx,.txt,.zip"></label><textarea name="message" maxlength="2000" rows="1" placeholder="Type a message..."></textarea><button class="btn btn-primary" type="submit">Send</button><p class="send-error" role="alert" hidden>Failed to send. <button type="button">Retry</button></p></form></c:otherwise></c:choose></section>
</main></div><script src="${pageContext.request.contextPath}/assets/js/private-chat.js?v=${applicationScope.assetVersion}" defer></script></body></html>
