<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Private Messages | StudentHub</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><script src="${pageContext.request.contextPath}/assets/js/main.js?v=${applicationScope.assetVersion}" defer></script><link href="${pageContext.request.contextPath}/assets/css/main.css?v=${applicationScope.assetVersion}" rel="stylesheet"><link href="${pageContext.request.contextPath}/assets/css/dashboard.css?v=${applicationScope.assetVersion}" rel="stylesheet"><link href="${pageContext.request.contextPath}/assets/css/dashboard-refined.css?v=${applicationScope.assetVersion}" rel="stylesheet"></head><body class="dashboard-body">
<header class="mobile-header"><a class="dashboard-brand" href="${pageContext.request.contextPath}/home"><span>S</span> StudentHub</a></header><div class="dashboard-shell private-chat-shell"><aside class="dashboard-sidebar"><jsp:include page="../partials/sidebar.jsp"/></aside><main class="private-chat-layout">
<aside class="conversation-list ${not empty selectedConversation ? 'has-selection' : ''}" data-search-url="${pageContext.request.contextPath}/users/search" data-start-url="${pageContext.request.contextPath}/messages/start" data-csrf="<c:out value='${csrfToken}'/>"><header><h1>Messages</h1></header><nav class="message-mode-switch" aria-label="Messaging sections"><a class="active" href="${pageContext.request.contextPath}/messages" aria-current="page">Private Messages</a><a href="${pageContext.request.contextPath}/discussions">Academic Discussions</a></nav><div class="people-search"><label class="visually-hidden" for="peopleSearch">Search people</label><input id="peopleSearch" type="search" placeholder="Search people..." autocomplete="off" aria-controls="peopleResults"><div class="people-results" id="peopleResults" hidden aria-live="polite"></div></div><c:choose><c:when test="${empty conversations}"><p class="private-empty">Open a student's profile and choose Message to begin.</p></c:when><c:otherwise><c:forEach var="conversation" items="${conversations}"><a class="conversation-item ${selectedConversation.conversationId eq conversation.conversationId ? 'active' : ''}" href="${pageContext.request.contextPath}/messages?conversationId=${conversation.conversationId}"><span class="conversation-avatar"><jsp:include page="../partials/avatar.jsp"><jsp:param name="photo" value="${conversation.otherAvatar}"/><jsp:param name="initial" value="${conversation.otherName.substring(0,1)}"/></jsp:include></span><span class="conversation-copy"><strong><c:out value="${conversation.otherName}"/></strong><small><c:out value="${conversation.preview}"/></small></span><span class="conversation-meta"><time><c:out value="${conversation.updatedLabel}"/></time><c:if test="${conversation.unread gt 0}"><b><c:out value="${conversation.unread}"/></b></c:if></span></a></c:forEach></c:otherwise></c:choose></aside>
<section class="private-thread"><c:choose><c:when test="${empty selectedConversation}"><div class="private-empty thread-empty"><h2>Your private messages</h2><p>Select a conversation to start chatting.</p></div></c:when><c:otherwise><header class="private-thread-header"><a class="thread-back" href="${pageContext.request.contextPath}/messages" aria-label="Back">&#8592;</a><a href="${pageContext.request.contextPath}/profile?userId=${selectedConversation.otherUserId}" class="thread-identity"><span class="thread-avatar"><jsp:include page="../partials/avatar.jsp"><jsp:param name="photo" value="${selectedConversation.otherAvatar}"/><jsp:param name="initial" value="${selectedConversation.otherName.substring(0,1)}"/></jsp:include></span><span><strong><c:out value="${selectedConversation.otherName}"/></strong><small class="${selectedConversation.activeNow ? 'active-now' : ''}"><c:out value="${selectedConversation.presenceLabel}"/></small></span></a></header>
<div class="private-message-list" data-conversation="${selectedConversation.conversationId}" data-current-user="${sessionScope.userId}" data-seen-url="${pageContext.request.contextPath}/messages/seen" data-csrf="<c:out value='${csrfToken}'/>"><c:forEach var="chatMessage" items="${privateMessages}"><c:set var="own" value="${chatMessage.senderId eq sessionScope.userId}"/><article class="private-bubble ${own ? 'outgoing' : 'incoming'}" data-message-id="${chatMessage.messageId}"><c:if test="${not empty chatMessage.message}"><p><c:out value="${chatMessage.message}"/></p></c:if><c:if test="${not empty chatMessage.attachment}"><c:url var="fileUrl" value="/messages/attachments/${chatMessage.attachment.attachmentId}"/><div class="private-file"><c:choose><c:when test="${chatMessage.attachment.image}"><img src="${fileUrl}" alt=""><a href="${fileUrl}?download=1">Download image</a></c:when><c:when test="${chatMessage.attachment.video}"><video controls preload="metadata" src="${fileUrl}"></video><a href="${fileUrl}?download=1">Download video</a></c:when><c:when test="${chatMessage.attachment.audio}"><strong><c:out value="${chatMessage.attachment.originalFilename}"/></strong><audio controls preload="metadata" src="${fileUrl}"></audio><a href="${fileUrl}?download=1">Download audio</a></c:when><c:otherwise><a href="${fileUrl}?download=1"><c:out value="${chatMessage.attachment.originalFilename}"/> · <c:out value="${chatMessage.attachment.sizeLabel}"/></a></c:otherwise></c:choose></div></c:if><div class="message-meta"><time><c:out value="${chatMessage.createdLabel}"/></time><c:if test="${own}"><span class="message-receipt" data-status="${chatMessage.status}">${chatMessage.status eq 'SEEN' ? '✓✓' : chatMessage.status eq 'DELIVERED' ? '✓✓' : '✓'}</span></c:if></div></article></c:forEach></div>
<form class="private-composer" enctype="multipart/form-data" action="${pageContext.request.contextPath}/messages/send"><input type="hidden" name="csrfToken" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="conversationId" value="${selectedConversation.conversationId}"><input type="hidden" name="clientMessageId"><div class="attachment-preview" hidden></div><div class="composer-row"><label class="attachment-button" title="Attach image, video, audio or file" aria-label="Attach image, video, audio or file">&#128206;<input name="attachment" type="file" accept="image/jpeg,image/png,image/webp,video/mp4,video/webm,audio/mpeg,audio/mp4,audio/aac,audio/wav,audio/ogg,audio/webm,.pdf,.doc,.docx,.ppt,.pptx,.xls,.xlsx,.txt,.zip"></label><textarea name="message" maxlength="2000" rows="1" placeholder="Type a message..." aria-label="Message"></textarea><button class="btn btn-primary" type="submit" aria-label="Send message">Send</button></div><p class="send-error" role="alert" hidden>Failed to send. <button type="button">Retry</button></p></form></c:otherwise></c:choose></section></main></div><jsp:include page="../partials/mobile-bottom-nav.jsp" /><script src="${pageContext.request.contextPath}/assets/js/private-chat.js?v=${applicationScope.assetVersion}" defer></script></body></html>
