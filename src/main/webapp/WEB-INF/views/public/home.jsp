<%@ page contentType="text/html;charset=UTF-8" %><!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>StudentHub | Your campus, better organized</title><meta name="description" content="StudentHub organizes announcements, deadlines, notifications and discussions around your academic community."><script src="${pageContext.request.contextPath}/assets/js/theme.js?v=${applicationScope.assetVersion}"></script><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/public.css?v=${applicationScope.assetVersion}"><script src="${pageContext.request.contextPath}/assets/js/public.js?v=${applicationScope.assetVersion}" defer></script></head><body class="public-page"><jsp:include page="partials/header.jsp"/><main>
<section class="home-hero"><div class="public-container hero-layout"><div class="hero-copy"><p class="eyebrow">Your campus. Better organized.</p><h1>Everything important,<br>right where <span>students</span><br>need it.</h1><p>Announcements, deadlines, notifications and discussions — organized around your academic community.</p><div class="hero-actions"><a class="button primary" href="${pageContext.request.contextPath}/register">Get Started <span aria-hidden="true">→</span></a><a class="button ghost" href="${pageContext.request.contextPath}/login">Sign In <span aria-hidden="true">→</span></a></div><small>Built for university students and Class Representatives.</small></div>
<div class="hero-visual" aria-hidden="true"><div class="hero-orbit orbit-one"></div><div class="hero-orbit orbit-two"></div><div class="hero-visual-mark"><jsp:include page="../partials/logo.jsp"><jsp:param name="compact" value="true"/></jsp:include></div><span class="hero-node node-one"></span><span class="hero-node node-two"></span><span class="hero-node node-three"></span></div></div></section>
<section class="feature-strip"><div class="public-container strip-grid"><article><strong>Announcements</strong><span>Stay informed</span></article><article><strong>Deadlines</strong><span>Stay prepared</span></article><article><strong>Discussions</strong><span>Stay connected</span></article><article><strong>Notifications</strong><span>Never miss updates</span></article></div></section>
<section class="why-home"><div class="public-container why-layout"><div><p class="eyebrow">Why StudentHub?</p><h2>Important information shouldn't disappear inside hundreds of chat messages.</h2><p>Messages move fast. Important updates get buried. Deadlines get missed.</p><p>StudentHub keeps everything organized and easy to find.</p></div><div class="reason-list"><article><span>01</span><strong>Know what matters</strong></article><article><span>02</span><strong>Know when it's due</strong></article><article><span>03</span><strong>Know where to discuss it</strong></article></div></div></section>
<section class="home-core"><div class="public-container"><div class="section-title"><p class="eyebrow">Core features</p><h2>One focused place for university life.</h2></div><div class="core-grid"><article><span class="mini-mark">A</span><h3>Announcements + Deadlines</h3><p>Academic updates paired with the dates that matter.</p></article><article><span class="mini-mark">N</span><h3>Notifications</h3><p>Relevant alerts without crowded group-chat noise.</p></article><article><span class="mini-mark">D</span><h3>Discussion Rooms</h3><p>Conversations remain organized around the academic groups you can access.</p></article><article><span class="mini-mark">M</span><h3>Private Messages</h3><p>Continue direct conversations without losing important campus context.</p></article></div></div></section>
</main><jsp:include page="partials/footer.jsp"/></body></html>
