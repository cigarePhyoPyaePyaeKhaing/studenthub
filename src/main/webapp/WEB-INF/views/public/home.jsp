<%@ page contentType="text/html;charset=UTF-8" %><!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>StudentHub | Student life, organized</title><meta name="description" content="StudentHub keeps announcements, deadlines, notifications and university discussions organized in one place."><script src="${pageContext.request.contextPath}/assets/js/theme.js"></script><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/public.css?v=20260822"><script src="${pageContext.request.contextPath}/assets/js/public.js?v=20260822" defer></script></head><body class="public-page"><jsp:include page="partials/header.jsp"/><main><section class="hero"><div class="public-container hero-grid"><div class="hero-copy"><p class="eyebrow">Student life, organized.</p><h1>Everything important.<br><span>One StudentHub.</span></h1><p class="hero-lead">Stay updated with announcements, deadlines, notifications and discussions — all in one place.</p><p class="hero-support">StudentHub brings your academic community together so important information never gets buried in group chats.</p><div class="hero-actions"><a class="public-button" href="${pageContext.request.contextPath}/register">Get Started <span aria-hidden="true">→</span></a><a class="public-button secondary" href="${pageContext.request.contextPath}/login">Sign In</a></div><p class="hero-note">Built for students. Designed for campus life.</p></div><div class="ui-scene" aria-label="Decorative StudentHub updates preview"><div class="app-window"><div class="app-bar"><span>StudentHub</span><span class="app-dot"></span></div><div class="updates"><h2>Latest Updates</h2><article class="update-card"><span class="update-icon">A</span><div><strong>Database Assignment</strong><span>Assignment</span></div><span class="due">Due tomorrow</span></article><article class="update-card"><span class="update-icon">E</span><div><strong>Linear Algebra Exam</strong><span>Exam</span></div><span class="due">3 days left</span></article></div></div><span class="floating-note one">New Announcement</span><span class="floating-note two">Assignment due tomorrow</span><span class="floating-note three">3 new notifications</span></div></div></section><section class="value-section"><div class="public-container"><div class="section-heading"><div><p class="eyebrow">The essentials</p><h2>What matters, easy to find.</h2></div><a class="text-link" href="${pageContext.request.contextPath}/features">Explore All Features →</a></div><div class="value-grid"><article class="value-card"><span class="card-icon">A</span><h3>Announcements</h3><p>Relevant academic updates, clearly organized.</p></article><article class="value-card"><span class="card-icon">D</span><h3>Deadlines</h3><p>See important due dates before they pass.</p></article><article class="value-card"><span class="card-icon">C</span><h3>Discussions</h3><p>Connect with the right academic community.</p></article></div></div></section><section class="cta-section"><div class="public-container"><div class="cta-band"><h2>Your student life.<br>All in one place.</h2><a class="public-button" href="${pageContext.request.contextPath}/register">Get Started <span aria-hidden="true">→</span></a></div></div></section></main><jsp:include page="partials/footer.jsp"/></body></html>
