<%@ page contentType="text/html;charset=UTF-8" %><!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>StudentHub | Your campus, better organized</title><meta name="description" content="StudentHub organizes announcements, deadlines, notifications and discussions around your academic community."><script src="${pageContext.request.contextPath}/assets/js/theme.js"></script><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/public.css?v=20260822-3"><script src="${pageContext.request.contextPath}/assets/js/public.js?v=20260822-3" defer></script></head><body class="public-page"><jsp:include page="partials/header.jsp"/><main>
