<%@ page contentType="text/html;charset=UTF-8" %><!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>How It Works | StudentHub</title><script src="${pageContext.request.contextPath}/assets/js/theme.js"></script><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/public.css?v=20260822"><script src="${pageContext.request.contextPath}/assets/js/public.js?v=20260822" defer></script></head><body class="public-page"><jsp:include page="partials/header.jsp"/><main><section class="page-hero"><div class="public-container"><p class="eyebrow">A clear path in</p><h1>Simple from day one.</h1><p>StudentHub connects each account to the academic information and conversations that matter.</p></div></section><section class="content-section"><div class="public-container"><div class="steps"><article class="step-card"><span class="step-number">STEP 01</span><div><h2>Create your account</h2><p>Register using your student information.</p></div></article><article class="step-card"><span class="step-number">STEP 02</span><div><h2>Set your academic information</h2><p>Select your university, semester and section.</p></div></article><article class="step-card"><span class="step-number">STEP 03</span><div><h2>Join your academic community</h2><p>StudentHub connects relevant announcements and discussions to your academic scope.</p></div></article><article class="step-card"><span class="step-number">STEP 04</span><div><h2>Stay updated</h2><p>Receive announcements, deadlines and notifications.</p></div></article><article class="step-card"><span class="step-number">STEP 05</span><div><h2>Join discussions</h2><p>Communicate with the correct academic community.</p></div></article></div><div class="role-grid"><article class="role-card"><span class="role-label">STUDENT</span><h3>Your campus essentials</h3><ul><li>View announcements</li><li>Track deadlines</li><li>Notifications</li><li>Discussions</li></ul></article><article class="role-card"><span class="role-label">CLASS REPRESENTATIVE</span><h3>Relevant communication</h3><ul><li>Student capabilities</li><li>Create relevant announcements</li><li>Share assignments, tutorials and exams</li><li>Communicate with students</li></ul></article><article class="role-card"><span class="role-label">ADMIN</span><h3>Community oversight</h3><ul><li>Manage users</li><li>Manage academic data</li><li>Review academic information change requests</li></ul></article></div></div></section><section class="cta-section"><div class="public-container"><div class="cta-band"><h2>Join StudentHub.</h2><a class="public-button" href="${pageContext.request.contextPath}/register">Create Account <span aria-hidden="true">→</span></a></div></div></section></main><jsp:include page="partials/footer.jsp"/></body></html>
