<%@ page contentType="text/html;charset=UTF-8" %><!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>About | StudentHub</title><script src="${pageContext.request.contextPath}/assets/js/theme.js"></script><link rel="stylesheet" href="${pageContext.request.contextPath}/assets/css/public.css?v=20260822-3"><script src="${pageContext.request.contextPath}/assets/js/public.js?v=20260822-3" defer></script></head><body class="public-page"><jsp:include page="partials/header.jsp"/><main><section class="page-hero about-hero"><div class="public-container"><p class="eyebrow">Why StudentHub</p><h1>Built because campus communication<br>should be easier.</h1></div></section>
<section class="editorial-problem"><div class="public-container editorial-grid"><div><p class="eyebrow">The problem</p><p>Important updates disappear inside fast-moving group conversations.</p></div><blockquote>Too many messages.<br>Too many places.<br><span>Too easy to miss what matters.</span></blockquote></div></section>
<section class="purpose-section"><div class="public-container"><p class="eyebrow">One place for</p><div class="purpose-list"><span>Announcements</span><span>Academic deadlines</span><span>Notifications</span><span>Discussions</span><span>Student academic context</span></div></div></section>
<section class="audience-section"><div class="public-container"><div class="section-title"><p class="eyebrow">Built around the community</p><h2>Useful for every part of university life.</h2></div><div class="audience-grid"><article><span class="role-icon">S</span><h3>Students</h3><p>Find relevant academic information and discussions without searching through scattered messages.</p></article><article><span class="role-icon">CR</span><h3>Class Representatives</h3><p>Share structured updates with the semester and section that need them.</p></article><article><span class="role-icon">A</span><h3>Admins</h3><p>Maintain the academic structure and support a reliable university community.</p></article></div></div></section>
<section class="about-finale"><div class="public-container"><p>Designed around university life.</p><h2>University of Information Technology</h2><div><a class="button primary" href="${pageContext.request.contextPath}/register">Get Started</a><a class="button ghost" href="${pageContext.request.contextPath}/login">Sign In</a></div></div></section></main><jsp:include page="partials/footer.jsp"/></body></html>
