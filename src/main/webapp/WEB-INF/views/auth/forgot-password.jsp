<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Forgot password | StudentHub</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><script src="${pageContext.request.contextPath}/assets/js/main.js"></script><link href="${pageContext.request.contextPath}/assets/css/main.css" rel="stylesheet"></head><body class="auth-page"><main class="container py-5"><div class="auth-card card border-0 shadow-lg mx-auto"><div class="card-body p-4 p-md-5"><h1 class="h2">Forgot password</h1><p class="text-secondary">Enter your Student ID or email.</p><form method="post"><input type="hidden" name="csrfToken" value="<c:out value='${csrfToken}'/>"><div class="mb-4"><label class="form-label" for="login">Student ID or email</label><input class="form-control" id="login" name="login" maxlength="120" autocomplete="username" autofocus required></div><button class="btn btn-primary w-100" type="submit">Send verification code</button></form><a class="btn btn-link w-100 mt-2" href="${pageContext.request.contextPath}/login">Back to login</a></div></div></main></body></html>
