<%@ page contentType="text/html;charset=UTF-8" language="java" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Verify email | StudentHub</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><script src="${pageContext.request.contextPath}/assets/js/theme.js"></script><script src="${pageContext.request.contextPath}/assets/js/main.js?v=20260822-5" defer></script><script src="${pageContext.request.contextPath}/assets/js/password-recovery.js?v=20260822-5" defer></script><link href="${pageContext.request.contextPath}/assets/css/main.css?v=20260822-5" rel="stylesheet"><link href="${pageContext.request.contextPath}/assets/css/auth-refined.css?v=20260822-5" rel="stylesheet"></head><body class="auth-page auth-page-refined"><jsp:include page="auth-nav.jsp"><jsp:param name="accountPath" value="/login"/><jsp:param name="accountLabel" value="Back to Sign In"/></jsp:include>
<main class="auth-main"><section class="auth-card recovery-card card border-0" aria-labelledby="verify-email-title"><div class="card-body p-4 p-md-5 text-center"><div class="auth-card-brand"><span class="auth-brand-mark"><span>S</span></span></div><p class="auth-eyebrow">Secure your account</p><h1 class="h2" id="verify-email-title">Verify your email</h1><p class="text-secondary recovery-copy">Enter the six-digit code sent to your email. It expires in 10 minutes.</p><c:if test="${not empty message}"><div class="alert alert-success text-start"><c:out value="${message}"/></div></c:if>
<form method="post" action="${pageContext.request.contextPath}/verify-email" data-otp-form novalidate><input type="hidden" name="csrfToken" value="<c:out value='${csrfToken}'/>"><input type="hidden" name="code" data-otp-value><fieldset class="otp-fieldset"><legend class="visually-hidden">Six-digit verification code</legend><div class="otp-code-grid" role="group" aria-label="Six-digit verification code"><input class="otp-code-input" type="text" inputmode="numeric" pattern="[0-9]" maxlength="1" autocomplete="one-time-code" aria-label="Digit 1" autofocus><input class="otp-code-input" type="text" inputmode="numeric" pattern="[0-9]" maxlength="1" autocomplete="off" aria-label="Digit 2"><input class="otp-code-input" type="text" inputmode="numeric" pattern="[0-9]" maxlength="1" autocomplete="off" aria-label="Digit 3"><input class="otp-code-input" type="text" inputmode="numeric" pattern="[0-9]" maxlength="1" autocomplete="off" aria-label="Digit 4"><input class="otp-code-input" type="text" inputmode="numeric" pattern="[0-9]" maxlength="1" autocomplete="off" aria-label="Digit 5"><input class="otp-code-input" type="text" inputmode="numeric" pattern="[0-9]" maxlength="1" autocomplete="off" aria-label="Digit 6"></div><c:if test="${not empty error}"><p class="otp-error" role="alert"><c:out value="${error}"/></p></c:if></fieldset><button class="btn btn-primary verify-code-button" type="submit" data-verify-button disabled>Verify email</button></form>
<form method="post" action="${pageContext.request.contextPath}/resend-verification" class="resend-form"><input type="hidden" name="csrfToken" value="<c:out value='${csrfToken}'/>"><span>Didn't receive the code?</span><button class="resend-button" type="submit">Resend code</button></form></div></section></main></body></html>
