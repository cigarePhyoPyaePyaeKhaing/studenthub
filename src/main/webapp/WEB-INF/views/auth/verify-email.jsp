<%@ page contentType="text/html;charset=UTF-8" language="java" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Verify email | StudentHub</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><script src="${pageContext.request.contextPath}/assets/js/main.js" defer></script><link href="${pageContext.request.contextPath}/assets/css/main.css?v=20260821-2" rel="stylesheet"></head>
<body class="auth-page"><main class="container py-5"><div class="auth-card card border-0 shadow-lg mx-auto"><div class="card-body p-4 p-md-5"><h1 class="h2">Verify your email</h1><p class="text-secondary">Enter the six-digit code sent to your email. It expires in 10 minutes.</p>
<c:if test="${not empty message}"><div class="alert alert-success"><c:out value="${message}"/></div></c:if><c:if test="${not empty error}"><div class="alert alert-danger"><c:out value="${error}"/></div></c:if><form method="post" action="${pageContext.request.contextPath}/verify-email"><input type="hidden" name="csrfToken" value="<c:out value='${csrfToken}'/>"><div class="mb-4"><label class="form-label" for="code">Verification code</label><input class="form-control form-control-lg text-center" id="code" name="code" inputmode="numeric" pattern="[0-9]{6}" maxlength="6" autocomplete="one-time-code" required></div><button class="btn btn-primary w-100" type="submit">Verify email</button></form><form method="post" action="${pageContext.request.contextPath}/resend-verification"><input type="hidden" name="csrfToken" value="<c:out value='${csrfToken}'/>"><button class="btn btn-link w-100 mt-2" type="submit">Resend code</button></form></div></div></main></body></html>
