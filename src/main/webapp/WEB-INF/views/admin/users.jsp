<%@ page contentType="text/html;charset=UTF-8" language="java" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Users | StudentHub Admin</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><script src="${pageContext.request.contextPath}/assets/js/main.js?v=${applicationScope.assetVersion}" defer></script><script src="${pageContext.request.contextPath}/assets/js/admin-users.js?v=${applicationScope.assetVersion}" defer></script><link href="${pageContext.request.contextPath}/assets/css/main.css?v=${applicationScope.assetVersion}" rel="stylesheet"><link href="${pageContext.request.contextPath}/assets/css/dashboard.css?v=${applicationScope.assetVersion}" rel="stylesheet"><link href="${pageContext.request.contextPath}/assets/css/dashboard-refined.css?v=${applicationScope.assetVersion}" rel="stylesheet"></head><body class="dashboard-body">
<header class="mobile-header"><a class="dashboard-brand" href="${pageContext.request.contextPath}/home"><span>S</span> StudentHub</a><button class="btn btn-light" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileNavigation">Menu</button></header><div class="offcanvas offcanvas-start" tabindex="-1" id="mobileNavigation"><div class="offcanvas-header"><h2 class="offcanvas-title h5">StudentHub</h2><button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button></div><div class="offcanvas-body"><jsp:include page="../partials/sidebar.jsp" /></div></div>
<div class="dashboard-shell admin-shell"><aside class="dashboard-sidebar"><jsp:include page="../partials/sidebar.jsp" /></aside><main class="admin-column">
<section class="welcome-panel"><div><p class="eyebrow mb-2">Administration</p><h1>User Management</h1><p class="mb-0 text-secondary"><c:out value="${totalUsers}" /> matching users</p></div></section><c:if test="${not empty message}"><div class="alert alert-success"><c:out value="${message}" /></div></c:if><c:if test="${not empty error}"><div class="alert alert-warning"><c:out value="${error}" /></div></c:if>
<section class="admin-card admin-user-search-card"><form class="admin-search" method="get" action="${pageContext.request.contextPath}/admin/users"><label class="visually-hidden" for="userSearch">Search users</label><input class="form-control" id="userSearch" name="q" maxlength="100" value="<c:out value='${query}' />" placeholder="Search student ID, name, or email"><button class="btn btn-primary" type="submit">Search</button><c:if test="${not empty query}"><a class="btn btn-light" href="${pageContext.request.contextPath}/admin/users">Clear</a></c:if></form></section>
<c:set var="studentCount" value="0"/><c:set var="crCount" value="0"/><c:set var="adminCount" value="0"/><c:forEach var="user" items="${users}"><c:choose><c:when test="${user.role eq 'STUDENT'}"><c:set var="studentCount" value="${studentCount+1}"/></c:when><c:when test="${user.role eq 'CR'}"><c:set var="crCount" value="${crCount+1}"/></c:when><c:when test="${user.role eq 'ADMIN'}"><c:set var="adminCount" value="${adminCount+1}"/></c:when></c:choose></c:forEach>
<div class="admin-role-tabs" role="tablist" aria-label="User roles"><button type="button" role="tab" data-role-tab="STUDENT" id="student-tab" aria-controls="student-panel" aria-selected="true">Students <span><c:out value="${studentCount}"/></span></button><button type="button" role="tab" data-role-tab="CR" id="cr-tab" aria-controls="cr-panel" aria-selected="false" tabindex="-1">CRs <span><c:out value="${crCount}"/></span></button><button type="button" role="tab" data-role-tab="ADMIN" id="admin-tab" aria-controls="admin-panel" aria-selected="false" tabindex="-1">Admins <span><c:out value="${adminCount}"/></span></button></div>
<section id="student-panel" role="tabpanel" aria-labelledby="student-tab" class="admin-card admin-role-section role-section-student" data-role-section="STUDENT"><header class="admin-role-header"><span class="admin-role-icon" aria-hidden="true">S</span><div><h2>Students</h2><p>Student accounts in these search results</p></div><span class="admin-role-count"><c:out value="${studentCount}"/></span></header><div class="admin-table-wrap role-user-table-wrap"><table class="admin-table role-user-table"><thead><tr><th>Student ID</th><th>Name</th><th>Email</th><th>Semester</th><th>Section</th><th>Status</th><th>View</th></tr></thead><tbody><c:forEach var="user" items="${users}"><c:if test="${user.role eq 'STUDENT'}"><tr><td><c:out value="${user.studentId}"/></td><td><c:out value="${user.fullName}"/></td><td><c:out value="${user.email}"/></td><td><c:out value="${empty user.semester?'Not set':user.semester}"/></td><td><c:out value="${empty user.sectionName?'Not set':user.sectionName}"/></td><td>${user.emailVerified?'Verified':'Unverified'}</td><td><a class="admin-view-link" href="${pageContext.request.contextPath}/admin/users/view?id=${user.userId}">View</a></td></tr></c:if></c:forEach><c:if test="${studentCount eq 0}"><tr class="role-empty-row"><td colspan="7">No matching student accounts.</td></tr></c:if></tbody></table></div></section>
<section id="cr-panel" role="tabpanel" aria-labelledby="cr-tab" class="admin-card admin-role-section role-section-cr" data-role-section="CR" hidden><header class="admin-role-header"><span class="admin-role-icon" aria-hidden="true">CR</span><div><h2>CRs</h2><p>Class representative accounts in these results</p></div><span class="admin-role-count"><c:out value="${crCount}"/></span></header><div class="admin-table-wrap role-user-table-wrap"><table class="admin-table role-user-table"><thead><tr><th>Student ID</th><th>Name</th><th>Email</th><th>Semester</th><th>Section</th><th>Status</th><th>View</th></tr></thead><tbody><c:forEach var="user" items="${users}"><c:if test="${user.role eq 'CR'}"><tr><td><c:out value="${user.studentId}"/></td><td><c:out value="${user.fullName}"/></td><td><c:out value="${user.email}"/></td><td><c:out value="${empty user.semester?'Not set':user.semester}"/></td><td><c:out value="${empty user.sectionName?'Not set':user.sectionName}"/></td><td>${user.emailVerified?'Verified':'Unverified'}</td><td><a class="admin-view-link" href="${pageContext.request.contextPath}/admin/users/view?id=${user.userId}">View</a></td></tr></c:if></c:forEach><c:if test="${crCount eq 0}"><tr class="role-empty-row"><td colspan="7">No matching CR accounts.</td></tr></c:if></tbody></table></div></section>
<section id="admin-panel" role="tabpanel" aria-labelledby="admin-tab" class="admin-card admin-role-section role-section-admin" data-role-section="ADMIN" hidden><header class="admin-role-header"><span class="admin-role-icon" aria-hidden="true">A</span><div><h2>Admins</h2><p>Administrator accounts in these results</p></div><span class="admin-role-count"><c:out value="${adminCount}"/></span></header><div class="admin-table-wrap role-user-table-wrap"><table class="admin-table role-user-table role-admin-table"><thead><tr><th>Student ID</th><th>Name</th><th>Email</th><th>Status</th><th>View</th></tr></thead><tbody><c:forEach var="user" items="${users}"><c:if test="${user.role eq 'ADMIN'}"><tr><td><c:out value="${user.studentId}"/></td><td><c:out value="${user.fullName}"/></td><td><c:out value="${user.email}"/></td><td>${user.emailVerified?'Verified':'Unverified'}</td><td><a class="admin-view-link" href="${pageContext.request.contextPath}/admin/users/view?id=${user.userId}">View</a></td></tr></c:if></c:forEach><c:if test="${adminCount eq 0}"><tr class="role-empty-row"><td colspan="5">No matching admin accounts.</td></tr></c:if></tbody></table></div></section>
</main></div><jsp:include page="../partials/mobile-bottom-nav.jsp" /><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script></body></html>
