<%@ page contentType="text/html;charset=UTF-8" language="java" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Admin Dashboard | StudentHub</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><script src="${pageContext.request.contextPath}/assets/js/main.js?v=${applicationScope.assetVersion}" defer></script><link href="${pageContext.request.contextPath}/assets/css/main.css?v=${applicationScope.assetVersion}" rel="stylesheet"><link href="${pageContext.request.contextPath}/assets/css/dashboard.css?v=${applicationScope.assetVersion}" rel="stylesheet"></head><body class="dashboard-body"><header class="mobile-header"><a class="dashboard-brand" href="${pageContext.request.contextPath}/home"><span>S</span> StudentHub</a><button class="btn btn-light" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileNavigation">Menu</button></header><div class="offcanvas offcanvas-start" tabindex="-1" id="mobileNavigation"><div class="offcanvas-header"><h2 class="offcanvas-title h5">StudentHub</h2><button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button></div><div class="offcanvas-body"><jsp:include page="../partials/sidebar.jsp" /></div></div>
<div class="dashboard-shell admin-shell"><aside class="dashboard-sidebar"><jsp:include page="../partials/sidebar.jsp" /></aside><main class="admin-column"><section class="welcome-panel"><div><p class="eyebrow mb-2">Administration</p><h1>Admin Dashboard</h1><p class="mb-0 text-secondary">StudentHub users and community activity at a glance.</p></div><a class="btn btn-primary" href="${pageContext.request.contextPath}/admin/users">Manage users</a></section><c:if test="${not empty error}"><div class="alert alert-warning"><c:out value="${error}" /></div></c:if>
<c:if test="${not empty stats}"><section class="admin-stats" aria-label="StudentHub statistics"><div><span>Total users</span><strong><c:out value="${stats.totalUsers}" /></strong></div><div><span>Students</span><strong><c:out value="${stats.students}" /></strong></div><div><span>CRs</span><strong><c:out value="${stats.crs}" /></strong></div><div><span>Admins</span><strong><c:out value="${stats.admins}" /></strong></div><div><span>Announcements</span><strong><c:out value="${stats.announcements}" /></strong></div><div><span>Deadlines</span><strong><c:out value="${stats.deadlines}" /></strong></div><div><span>Discussion messages</span><strong><c:out value="${stats.discussionMessages}" /></strong></div><div><span>Comments</span><strong><c:out value="${stats.comments}" /></strong></div><div><span>Reactions</span><strong><c:out value="${stats.reactions}" /></strong></div><div><span>Verified users</span><strong><c:out value="${stats.verifiedUsers}" /></strong></div><div><span>Unverified users</span><strong><c:out value="${stats.unverifiedUsers}" /></strong></div></section></c:if>
<section class="admin-card"><div class="admin-card-heading"><div><p class="eyebrow mb-1">Latest accounts</p><h2>Recent users</h2></div><a href="${pageContext.request.contextPath}/admin/users">View all</a></div><div class="admin-table-wrap"><table class="admin-table"><thead><tr><th>Student ID</th><th>Name</th><th>Role</th><th>Academic scope</th><th>Status</th><th>Created</th></tr></thead><tbody><c:forEach var="user" items="${recentUsers}"><tr><td><c:out value="${user.studentId}" /></td><td><a href="${pageContext.request.contextPath}/admin/users/view?id=${user.userId}"><c:out value="${user.fullName}" /></a></td><td><span class="role-badge role-${user.role}"><c:out value="${user.role}" /></span></td><td><c:choose><c:when test="${empty user.semester}">Not set</c:when><c:otherwise>Semester <c:out value="${user.semester}" /><c:if test="${not empty user.sectionName}"> / <c:out value="${user.sectionName}" /></c:if></c:otherwise></c:choose></td><td>${user.emailVerified ? 'Verified' : 'Unverified'}</td><td><c:out value="${user.createdLabel}" /></td></tr></c:forEach><c:if test="${empty recentUsers}"><tr><td colspan="6">No users found.</td></tr></c:if></tbody></table></div></section></main></div><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script></body></html>
