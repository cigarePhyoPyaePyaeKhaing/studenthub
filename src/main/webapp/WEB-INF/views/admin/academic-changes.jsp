<%@ page contentType="text/html;charset=UTF-8" %><%@ taglib prefix="c" uri="jakarta.tags.core" %><!doctype html><html><head><meta name="viewport" content="width=device-width,initial-scale=1"><title>Academic Changes | StudentHub</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><script src="${pageContext.request.contextPath}/assets/js/main.js"></script><link href="${pageContext.request.contextPath}/assets/css/main.css" rel="stylesheet"><link href="${pageContext.request.contextPath}/assets/css/dashboard.css" rel="stylesheet"></head><body class="dashboard-body"><div class="dashboard-shell admin-shell"><aside class="dashboard-sidebar d-none d-lg-flex"><jsp:include page="../partials/sidebar.jsp"/></aside><main class="admin-column"><section class="welcome-panel"><div><p class="eyebrow">Administration</p><h1>Academic Change Requests</h1></div></section><c:if test="${not empty error}"><div class="alert alert-danger"><c:out value="${error}"/></div></c:if><div class="admin-card"><c:forEach var="item" items="${requests}"><article class="workflow-card"><h2><c:out value="${item.fullName}"/> · <c:out value="${item.studentId}"/></h2><p>Semester <c:out value="${item.oldSemester}"/> / <c:out value="${item.oldSection}"/> → Semester <c:out value="${item.requestedSemester}"/> / <c:out value="${item.requestedSection}"/></p><p><c:out value="${item.reason}"/></p><form method="post"><input type="hidden" name="csrfToken" value="${csrfToken}"><input type="hidden" name="id" value="${item.requestId}"><input class="form-control" name="adminNote" maxlength="1000" placeholder="Admin note"><button class="btn btn-primary" name="decision" value="approve">Approve</button><button class="btn btn-light" name="decision" value="reject">Reject</button></form></article></c:forEach><c:if test="${empty requests and empty error}"><p>No pending requests.</p></c:if></div></main></div></body></html>
