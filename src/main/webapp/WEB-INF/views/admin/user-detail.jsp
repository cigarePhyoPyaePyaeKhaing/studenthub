<%@ page contentType="text/html;charset=UTF-8" language="java" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>User Details | StudentHub Admin</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><script src="${pageContext.request.contextPath}/assets/js/main.js"></script><link href="${pageContext.request.contextPath}/assets/css/main.css" rel="stylesheet"><link href="${pageContext.request.contextPath}/assets/css/dashboard.css" rel="stylesheet"></head><body class="dashboard-body"><header class="mobile-header d-lg-none"><a class="dashboard-brand" href="${pageContext.request.contextPath}/home"><span>S</span> StudentHub</a></header><div class="dashboard-shell admin-shell"><aside class="dashboard-sidebar d-none d-lg-flex"><jsp:include page="../partials/sidebar.jsp" /></aside><main class="admin-column"><a class="comments-back" href="${pageContext.request.contextPath}/admin/users">← Back to users</a><c:if test="${not empty message}"><div class="alert alert-success"><c:out value="${message}" /></div></c:if><c:if test="${not empty error}"><div class="alert alert-warning"><c:out value="${error}" /></div></c:if>
<c:if test="${not empty managedUser}"><section class="profile-hero"><div class="profile-avatar"><c:out value="${managedUser.fullName.substring(0,1)}" /></div><div><p class="eyebrow mb-1">Managed account</p><h1><c:out value="${managedUser.fullName}" /></h1><p><c:out value="${managedUser.studentId}" /></p></div><span class="profile-role role-${managedUser.role}"><c:out value="${managedUser.role}" /></span></section><div class="profile-grid"><section class="profile-card"><div class="profile-card-heading"><h2>Account information</h2></div><dl class="profile-details"><div><dt>Student ID</dt><dd><c:out value="${managedUser.studentId}" /></dd></div><div><dt>Full name</dt><dd><c:out value="${managedUser.fullName}" /></dd></div><div><dt>Email</dt><dd><c:out value="${managedUser.email}" /></dd></div><div><dt>Verification</dt><dd>${managedUser.emailVerified ? 'Verified' : 'Unverified'}</dd></div><div><dt>Created</dt><dd><c:out value="${managedUser.createdLabel}" /></dd></div></dl></section><section class="profile-card"><div class="profile-card-heading"><h2>Academic and role</h2></div><dl class="profile-details"><div><dt>Semester</dt><dd><c:out value="${empty managedUser.semester ? 'Not set' : managedUser.semester}" /></dd></div><div><dt>Section</dt><dd><c:out value="${empty managedUser.sectionName ? 'Not set' : managedUser.sectionName}" /></dd></div></dl><form class="admin-role-form" method="post" action="${pageContext.request.contextPath}/admin/users/role" onsubmit="return confirm('Change this user’s authorization role?');"><input type="hidden" name="csrfToken" value="<c:out value='${csrfToken}' />"><input type="hidden" name="userId" value="${managedUser.userId}"><label for="role">Role</label><select class="form-select" id="role" name="role"><option value="STUDENT" ${managedUser.role eq 'STUDENT'?'selected':''}>STUDENT</option><option value="CR" ${managedUser.role eq 'CR'?'selected':''}>CR</option><option value="ADMIN" ${managedUser.role eq 'ADMIN'?'selected':''}>ADMIN</option></select><button class="btn btn-primary" type="submit">Update role</button><p>Role changes take effect for that user on their next login.</p></form></section></div></c:if></main></div></body></html>
