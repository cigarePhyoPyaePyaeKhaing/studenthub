<%@ page contentType="text/html;charset=UTF-8" language="java" %><%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Notifications | StudentHub</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"><script src="${pageContext.request.contextPath}/assets/js/main.js" defer></script><link href="${pageContext.request.contextPath}/assets/css/main.css?v=20260822-7" rel="stylesheet"><link href="${pageContext.request.contextPath}/assets/css/dashboard.css?v=20260822-7" rel="stylesheet"></head><body class="dashboard-body">
<header class="mobile-header d-lg-none"><a class="dashboard-brand" href="${pageContext.request.contextPath}/home"><span>S</span> StudentHub</a><button class="btn btn-light" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileNavigation" aria-controls="mobileNavigation">Menu</button></header><div class="offcanvas offcanvas-start" tabindex="-1" id="mobileNavigation"><div class="offcanvas-header"><h2 class="offcanvas-title h5">StudentHub</h2><button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button></div><div class="offcanvas-body"><jsp:include page="partials/sidebar.jsp" /></div></div>
<div class="dashboard-shell notifications-shell"><aside class="dashboard-sidebar d-none d-lg-flex"><jsp:include page="partials/sidebar.jsp" /></aside><main class="feed-column"><section class="notification-page-header"><div><p class="eyebrow mb-2">StudentHub activity</p><h1>Notifications</h1><p>Stay updated with activity in your academic scope.</p></div><c:if test="${unreadNotificationCount gt 0}"><span class="notification-summary"><strong><c:out value="${unreadNotificationCount}"/></strong> unread</span></c:if></section><c:if test="${not empty error}"><div class="alert alert-warning"><c:out value="${error}" /></div></c:if>
<section class="notification-center-panel" aria-label="Notifications"><div class="notification-list refined-notification-list"><c:choose><c:when test="${empty notifications}"><div class="notification-empty"><div class="empty-icon" aria-hidden="true">✓</div><h2 class="h5">You're all caught up</h2><p>New StudentHub activity will appear here.</p></div></c:when><c:otherwise><c:forEach var="item" items="${notifications}"><article class="refined-notification ${item.read ? 'is-read' : 'unread'}"><span class="notification-kind-icon" aria-hidden="true"><c:choose><c:when test="${item.type eq 'ANNOUNCEMENT'}"><svg viewBox="0 0 24 24"><path d="M4 13V9l13-5v14L4 13Z"/><path d="M7 14v5h4v-4M17 9h3v4h-3"/></svg></c:when><c:when test="${item.type eq 'DEADLINE'}"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="3"/><path d="M8 3v4M16 3v4M3 10h18M8 14h3M13 14h3M8 17h3"/></svg></c:when><c:when test="${item.type eq 'COMMENT'}"><svg viewBox="0 0 24 24"><path d="M4 5h16v12H9l-5 4V5Z"/><path d="M8 9h8M8 13h5"/></svg></c:when><c:when test="${item.type eq 'REACTION'}"><svg viewBox="0 0 24 24"><path d="M12 20S4 16 4 9a4 4 0 0 1 7-2.6A4 4 0 0 1 20 9c0 7-8 11-8 11Z"/></svg></c:when><c:otherwise><svg viewBox="0 0 24 24"><path d="M18 9a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9ZM10 21h4"/></svg></c:otherwise></c:choose></span><span class="notification-dot" aria-hidden="true"></span><div class="notification-copy"><span class="notification-type"><c:out value="${item.type}" /></span><h2><c:out value="${item.title}" /></h2><p><c:out value="${item.message}" /></p><time><c:out value="${item.createdLabel}" /></time></div><div class="notification-actions"><a class="notification-view-action" href="${pageContext.request.contextPath}${item.linkUrl}">View</a><c:if test="${not item.read}"><form method="post" action="${pageContext.request.contextPath}/notifications"><input type="hidden" name="csrfToken" value="<c:out value='${csrfToken}' />"><input type="hidden" name="id" value="${item.notificationId}"><button type="submit">Mark as read</button></form></c:if></div></article></c:forEach></c:otherwise></c:choose></div></section></main></div><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script></body></html>
