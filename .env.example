STUDENTHUB_DB_URL=
STUDENTHUB_DB_USER=
STUDENTHUB_DB_PASSWORD=

BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=StudentHub

# Optional only when a separate allowed API frontend exists; not required for the JSP deployment.
FRONTEND_URL=
LOCAL_FRONTEND_URL=http://localhost:3000
APP_ENV=development

# Required in production: mount this path on persistent object/volume storage.
STUDENTHUB_ATTACHMENT_DIR=

# Required in production: mount a Railway Volume at this root. Profile photos use <root>/profile.
STUDENTHUB_UPLOAD_DIR=
